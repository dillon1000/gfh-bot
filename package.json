{
  "name": "gfh-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "tsx watch src/app/index.ts",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "start": "node dist/src/app/index.js",
    "register-commands": "tsx src/app/register-commands.ts",
    "register-commands:dist": "node dist/src/app/register-commands.js",
    "backfill:market-liquidity": "tsx src/app/backfill-market-liquidity.ts",
    "backfill:market-liquidity:dist": "node dist/src/app/backfill-market-liquidity.js",
    "backfill:market-forum-posts": "tsx src/app/backfill-market-forum-posts.ts",
    "backfill:market-forum-posts:dist": "node dist/src/app/backfill-market-forum-posts.js",
    "backfill:starboard-reactions": "tsx src/app/backfill-starboard-reactions.ts",
    "backfill:starboard-reactions:dist": "node dist/src/app/backfill-starboard-reactions.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@fontsource/public-sans": "^5.2.7",
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@tabler/icons": "^3.44.0",
    "bullmq": "^5.76.8",
    "chrono-node": "^2.9.1",
    "d3": "^7.9.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "luxon": "^3.7.2",
    "mathjax-full": "^3.2.2",
    "pg": "8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.7.0",
    "@types/pg": "8.20.0",
    "tsc-alias": "1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
