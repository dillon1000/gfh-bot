{
  "name": "gfh-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24.15.0"
  },
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "dev": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import tsx --import ./src/app/instrumentation.ts --watch src/app/index.ts",
    "lint": "biome lint --diagnostic-level=error .",
    "lint:fix": "biome lint --write .",
    "start": "node --experimental-loader=@opentelemetry/instrumentation/hook.mjs --import ./dist/src/app/instrumentation.js dist/src/app/index.js",
    "register-commands": "tsx src/app/register-commands.ts",
    "register-commands:dist": "node dist/src/app/register-commands.js",
    "backfill:market-liquidity": "tsx src/app/backfill-market-liquidity.ts",
    "backfill:market-liquidity:dist": "node dist/src/app/backfill-market-liquidity.js",
    "backfill:market-forum-posts": "tsx src/app/backfill-market-forum-posts.ts",
    "backfill:market-forum-posts:dist": "node dist/src/app/backfill-market-forum-posts.js",
    "backfill:starboard-reactions": "tsx src/app/backfill-starboard-reactions.ts",
    "backfill:starboard-reactions:dist": "node dist/src/app/backfill-starboard-reactions.js",
    "backfill:poll-analytics": "tsx src/app/backfill-poll-analytics.ts",
    "backfill:poll-analytics:dist": "node dist/src/app/backfill-poll-analytics.js",
    "backfill:poll-hide-final-results": "tsx src/app/backfill-poll-hide-final-results.ts",
    "backfill:poll-hide-final-results:dist": "node dist/src/app/backfill-poll-hide-final-results.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@fontsource/public-sans": "^5.3.0",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@napi-rs/canvas": "^1.0.13",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "bullmq": "^6.4.0",
    "bullmq-otel": "^2.0.1",
    "chrono-node": "^2.10.3",
    "d3": "^7.9.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/d3": "^7.4.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25",
    "@types/pg": "8.23.1",
    "tsc-alias": "1.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
